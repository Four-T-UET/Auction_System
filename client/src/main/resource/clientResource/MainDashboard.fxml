<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom right, #f0f4ff, #e8f0ff);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clientController.ControlDashBoard">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #ffffff, #f8faff); -fx-border-color: #e0e7ff; -fx-border-width: 0 0 2 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0.15, 0, 2);" BorderPane.alignment="CENTER">
         <children>
            <Label text="E-Trade Dashboard" textFill="#1a2847">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
               <HBox.margin>
                  <Insets left="28.0" />
               </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" prefHeight="40.0" prefWidth="280.0" promptText="🔍 Search items..." style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #c7d2fe; -fx-border-width: 2; -fx-padding: 0 18 0 18; -fx-font-size: 14; -fx-focus-color: #3b82f6; -fx-faint-focus-color: #3b82f625;" />
            <ComboBox fx:id="categoryComBox" onAction="#chooseCategory" prefHeight="40.0" prefWidth="150.0" promptText="Category" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #c7d2fe; -fx-border-width: 2;" />
            <Button fx:id="findItem" mnemonicParsing="false" onAction="#Find" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #3b82f6, #2563eb); -fx-text-fill: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.25), 8, 0.2, 0, 2);" text="🔎 Find">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <HBox.margin>
                  <Insets right="28.0" />
               </HBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="240.0" spacing="8.0" style="-fx-background-color: linear-gradient(to bottom, #1f3a93, #1a2847); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0.2, 0, 0);" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="mainScene" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#returnToMain" prefHeight="48.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 15;" text="📊 Main Dashboard" textFill="#f2f0f0">
               <font>
                  <Font size="15.0" />
               </font>
               <padding>
                  <Insets left="28.0" />
               </padding>
            </Button>
            <Button fx:id="acountBut" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#changeToAccount" prefHeight="48.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 15;" text="👤 User Account">
               <font>
                  <Font size="15.0" />
               </font>
               <padding>
                  <Insets left="28.0" />
               </padding>
            </Button>
            <Button fx:id="historyBut" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#chageToHistory" prefHeight="48.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 15;" text="📜 Buy History">
               <font>
                  <Font size="15.0" />
               </font>
               <padding>
                  <Insets left="28.0" />
               </padding>
            </Button>
            <Button fx:id="walletBut" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#chageToWallet" prefHeight="48.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 15;" text="💳 My Wallet">
               <font>
                  <Font size="15.0" />
               </font>
               <padding>
                  <Insets left="28.0" />
               </padding>
            </Button>
            <Button fx:id="sellingBut" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#chageToSelling" prefHeight="48.0" style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-cursor: hand; -fx-font-size: 15;" text="🏪 Start Selling">
               <font>
                  <Font size="15.0" />
               </font>
               <padding>
                  <Insets left="28.0" />
               </padding>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets top="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <AnchorPane BorderPane.alignment="CENTER">
         <children>
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
      </AnchorPane>
   </center>
</BorderPane>
