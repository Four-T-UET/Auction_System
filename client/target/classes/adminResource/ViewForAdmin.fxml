<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: linear-gradient(to bottom right, #fce4e4, #fff0f0); -fx-padding: 40;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="adminController.ControlView">
    <children>
        <HBox spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(183, 28, 28, 0.15), 25, 0, 0, 10); -fx-padding: 35;">
            <children>

                <VBox alignment="TOP_CENTER" prefWidth="350.0" spacing="20.0">
                    <children>
                        <StackPane style="-fx-background-color: #ffebee; -fx-background-radius: 15; -fx-border-color: #ffcdd2; -fx-border-width: 2; -fx-border-radius: 15; -fx-padding: 10;">
                            <children>
                                <ImageView fx:id="itemImageView" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>

                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="Status:" textFill="#757575">
                                <font>
                                    <Font name="System Bold" size="16.0" />
                                </font>
                            </Label>
                            <Label fx:id="statusLabel" alignment="CENTER" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: linear-gradient(to right, #43a047, #2e7d32); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 20; -fx-padding: 5 15 5 15;" text="ACTIVE" />
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Auction Information" textFill="#b71c1c">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <GridPane hgap="15.0" style="-fx-background-color: #fffafb; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #ffcdd2; -fx-border-radius: 12;" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120.0" prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Owner:" textFill="#b71c1c" GridPane.rowIndex="1">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>
                                <Label fx:id="ownerLabel" text="N/A" textFill="#212121" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <font><Font size="15.0" /></font>
                                </Label>

                                <Label text="Current Winner:" textFill="#b71c1c" GridPane.rowIndex="2">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>
                                <Label fx:id="currentWinnerLabel" text="N/A" textFill="#1976d2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>

                                <Label text="Current Price:" textFill="#b71c1c" GridPane.rowIndex="3">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>
                                <Label fx:id="currentPriceLabel" text="N/A" textFill="#d32f2f" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>

                                <Label text="Minimum Step:" textFill="#b71c1c" GridPane.rowIndex="4">
                                    <font><Font name="System Bold" size="15.0" /></font>
                                </Label>
                                <Label fx:id="minimumStepLabel" text="N/A" textFill="#424242" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                    <font><Font size="15.0" /></font>
                                </Label>
                        <Label text="Name:" textFill="#b71c1c">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="name" text="N/A" textFill="#d119b1" GridPane.columnIndex="1">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label text="Category:" textFill="#b71c1c" GridPane.rowIndex="5">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="type" text="N/A" textFill="#424242" GridPane.columnIndex="1" GridPane.rowIndex="5">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                        <Label text="TimeLeft:" textFill="#b71c1c" GridPane.rowIndex="6">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Label>
                        <Label fx:id="timeLeft" text="N/A" textFill="#424242" GridPane.columnIndex="1" GridPane.rowIndex="6">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                            </children>
                        </GridPane>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Description:" textFill="#b71c1c">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <Label fx:id="descriptionLabel" alignment="TOP_LEFT" style="-fx-font-size: 14px; -fx-line-spacing: 4px;" text="Item description goes here..." textFill="#424242" wrapText="true">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </Label>
                                    </content>
                                    <style>
                                        -fx-border-color: #e0e0e0;
                                        -fx-border-radius: 8;
                                        -fx-background-radius: 8;
                                    </style>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <HBox alignment="BOTTOM_RIGHT" spacing="15.0">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
