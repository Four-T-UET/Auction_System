<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: #f4f6f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="adminResource.ControlManageUser">
    <children>
        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(183, 28, 28, 0.1), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Manage Users" textFill="#b71c1c">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #ffebee; -fx-padding: 8 15 8 15; -fx-background-radius: 20;">
                            <children>
                                <Label text="Total Users:" textFill="#d32f2f">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="totalUsersLabel" text="N/A" textFill="#b71c1c">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="Search username" style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-font-size: 14px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="searchBtn" mnemonicParsing="false" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #d32f2f, #b71c1c); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Search" />
                    </children>
                </HBox>

                <TableView fx:id="userTable" style="-fx-border-color: #ffcdd2; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCol" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="usernameCol" prefWidth="180.0" text="Username" />
                        <TableColumn fx:id="passWordCol" prefWidth="120.0" text="Password" />
                        <TableColumn fx:id="deleteCol" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Delete" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </children>
</VBox>
