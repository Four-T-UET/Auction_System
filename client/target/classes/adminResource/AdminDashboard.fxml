<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="adminMainPane" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="adminController.ControlAdminDashBoard">

    <top>
        <HBox fx:id="topHBox" alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: linear-gradient(to right, #d32f2f, #c62828); -fx-padding: 0 28 0 28;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Admin Dashboard" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="adminNameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 20 0 0;" text="Welcome, Admin (Super Role)" textFill="WHITE" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox fx:id="sidebarVBox" prefWidth="240.0" style="-fx-background-color: linear-gradient(to bottom, #b71c1c, #7b1fa2); -fx-padding: 20 0 20 0;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="manageAuctionsBtn" alignment="BASELINE_LEFT" onAction="#manageAuctionsBtn" prefHeight="48.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0 0 0 28; -fx-cursor: hand;" text="📋 Manage Auctions" />
                <Button fx:id="manageUsersBtn" alignment="BASELINE_LEFT" onAction="#userManager" prefHeight="48.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0 0 0 28; -fx-cursor: hand;" text="👥 Manage Users" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="logoutBtn" alignment="BASELINE_LEFT" onAction="#logoutBtn" prefHeight="48.0" prefWidth="240.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 0 0 0 28; -fx-cursor: hand;" text="🚪 Logout" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="mainPane" style="-fx-background-color: #f4f6f9; -fx-accent: #d32f2f; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" BorderPane.alignment="CENTER">
            <children>
                <Pagination fx:id="mainPagination" maxPageIndicatorCount="5" pageCount="10" style="-fx-page-information-visible: false; -fx-cursor: hand;" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>

</BorderPane>
