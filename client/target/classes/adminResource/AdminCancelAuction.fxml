<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="750.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom right, #b71c1c, #e53935, #ff8a80); -fx-padding: 40;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox maxWidth="600.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 0, 8);">
            <children>

                <Label text="Cancel Auction" textFill="#b71c1c">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>

                <VBox spacing="10.0" style="-fx-background-color: #fff0f0; -fx-padding: 15; -fx-border-color: #ffcdd2; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18px;" text="Auction Details" textFill="#c62828" />
                        <HBox spacing="10.0"><Label style="-fx-font-weight: bold;" text="Item Name:" /><Label fx:id="itemNameLabel" text="N/A" /></HBox>
                        <HBox spacing="10.0"><Label style="-fx-font-weight: bold;" text="Owner:" /><Label fx:id="ownerLabel" text="N/A" /></HBox>
                        <HBox spacing="10.0"><Label style="-fx-font-weight: bold;" text="Status:" /><Label fx:id="statusLabel" style="-fx-font-weight: bold;" text="N/A" textFill="#2e7d32" /></HBox>
                        <HBox spacing="10.0"><Label style="-fx-font-weight: bold;" text="Current Bid:" /><Label fx:id="currentBidLabel" style="-fx-font-weight: bold;" text="N/A" textFill="#d32f2f" /></HBox>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Item Image" textFill="#7f8c8d" />
                        <StackPane style="-fx-border-color: #ffcdd2; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #fafafa; -fx-padding: 10;">
                            <children>
                                <ImageView fx:id="itemImageView" fitHeight="200.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ProgressIndicator fx:id="progressIndicator" prefHeight="24.0" prefWidth="24.0" visible="false" />
                    <Label fx:id="messageLabel" style="-fx-font-size: 14px;" text="" textFill="#d32f2f" />
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="backBtn" mnemonicParsing="false" prefHeight="48.0" prefWidth="120.0" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Back" />

                        <Button fx:id="confirmCancelBtn" mnemonicParsing="false" prefHeight="48.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(to right, #d32f2f, #b71c1c); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(211,47,47,0.4), 10, 0, 0, 4); -fx-cursor: hand;" text="Confirm Cancel" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>
