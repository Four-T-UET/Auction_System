                    <!-- Details Card -->
                    <VBox spacing="14.0" style="-fx-background-color: linear-gradient(to bottom, #f8faff, #f0f7ff); -fx-background-radius: 14; -fx-border-color: #c7d2fe; -fx-border-width: 1; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.1), 8, 0.15, 0, 2);">
