                <!-- Bid Button -->
                <Button fx:id="Bidding" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBid" style="-fx-background-color: linear-gradient(to right, #3b82f6, #2563eb); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 16; -fx-cursor: hand; -fx-font-size: 16; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 12, 0.25, 0, 4);" text="🚀 Submit Bid">
                    <font>
