<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #f0f4ff, #e8f0ff);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControlBidding">
    <children>
        <!-- Khung bên trái: Hiển thị thông tin sản phẩm -->
        <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #ffffff; -fx-border-color: #e0e7ff; -fx-border-width: 0 2 0 0;" HBox.hgrow="ALWAYS">
            <VBox alignment="TOP_CENTER" prefHeight="400.0" spacing="24.0" style="-fx-padding: 28;">
                <children>
