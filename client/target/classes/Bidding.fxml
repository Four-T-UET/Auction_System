                    <VBox alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #f3f7ff, #eef3fb); -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e0e7ff; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0.2, 0, 4);">
