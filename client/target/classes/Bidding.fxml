                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label fx:id="productDescription" text="Product description..." textFill="#4b5563" wrapText="true" style="-fx-padding: 10; -fx-font-smoothing-type: gray;">
